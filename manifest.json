{
  "manifest_version": 3,
  "name": "Arena 模型助手",
  "version": "1.2.9",
  "description": "账号管理、Arena 会话入口与模型自动识别。",
  "action": {
    "default_title": "Arena 模型助手"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.arena.ai/*",
        "*://chat.lmsys.org/*",
        "*://*.lmarena.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116",
  "key": ""
}
